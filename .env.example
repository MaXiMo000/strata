# PostGIS, for the API and the ingesters
DATABASE_URL=postgresql://strata:strata@localhost:5432/strata
# TiTiler base URL, written into USGS tile URLs at ingest time (re-run the ingester when it changes)
TITILER_URL=http://localhost:8001
# Port of the API that the Vite dev server proxies /api to
STRATA_API=8012
